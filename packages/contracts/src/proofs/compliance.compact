// ============================================================
//  ZeroProof — Compliance Proof Contract (KYC/AML)
//  Compact Language (Midnight Network DSL)
//
//  PURPOSE:
//  Proves that an entity has passed KYC verification and AML
//  screening WITHOUT revealing the customer's identity, their
//  risk score, or any transaction history.
//
//  PRIVACY MODEL:
//  - PRIVATE: entityId, kycHash, amlScore, sanctionsMerkleProof
//  - PUBLIC: kycPassed, amlPassed, attestationId, timestamp
// ============================================================

pragma compact ^0.8.0;

import CompactStandardLibrary;

// ── Public Ledger State ──────────────────────────────────────
// Only compliance verdicts and audit trails live on-chain.
// No identity, no scores, no transaction hashes.
ledger ComplianceLedger {
  // Unique identifier for this compliance attestation
  attestationId: Bytes<32>;

  // KYC check result: did the entity pass identity verification?
  kycPassed: Boolean;

  // AML check result: did the entity pass anti-money laundering?
  amlPassed: Boolean;

  // Combined compliance status (both KYC and AML must pass)
  fullyCompliant: Boolean;

  // Merkle root of the sanctions list used during screening
  // Proves WHICH list was used without revealing who was checked
  sanctionsListRoot: Bytes<32>;

  // Timestamp of the compliance check
  timestamp: Uint<64>;

  // IPFS CID of the full attestation bundle
  ipfsCid: Bytes<64>;

  // Expiry timestamp (compliance certifications have time limits)
  validUntil: Uint<64>;
}

// ── Witness Types (Private Inputs) ──────────────────────────
// All sensitive KYC/AML data — processed locally, never transmitted.
witness entityIdHash: Bytes<32>;        // Poseidon hash of entity ID
witness kycVerificationHash: Bytes<32>; // Hash of KYC provider's signature
witness kycVerified: Uint<1>;           // 0 or 1 (boolean as uint for circuit)
witness amlRiskScore: Uint<8>;          // 0-100 risk score (lower = safer)
witness amlScoreThreshold: Uint<8>;     // Max acceptable score (e.g., 30)
witness sanctionsMerkleRoot: Bytes<32>; // Root of sanctions exclusion tree
witness sanctionsMerkleLeaf: Bytes<32>; // Entity's leaf in non-inclusion proof
witness sanctionsProofDepth: Uint<8>;   // Depth of Merkle non-inclusion proof
witness kycProviderSignature: Bytes<64>;// ECDSA signature from KYC provider
witness validityPeriodDays: Uint<16>;   // How long this attestation is valid

// ── KYC/AML Compliance Circuit ────────────────────────────────
export circuit proveCompliance(
  attestationId: Bytes<32>,
  ipfsCid: Bytes<64>,
  ts: Uint<64>
): ComplianceProofResult {

  // ── Step 1: Load private witnesses ───────────────────────
  const idHash = entityIdHash();
  const kycHash = kycVerificationHash();
  const kycStatus = kycVerified();
  const amlScore = amlRiskScore();
  const amlThreshold = amlScoreThreshold();
  const sanctionsRoot = sanctionsMerkleRoot();
  const validDays = validityPeriodDays();

  // ── Step 2: KYC verification ─────────────────────────────
  // Prove that a trusted KYC provider signed off on this entity
  // The provider's signature is verified inside the circuit
  // The actual identity (name, DOB, passport) stays private
  assert(kycStatus == (0 as Uint<1>) || kycStatus == (1 as Uint<1>), "invalid kyc status");
  const kycPassed = disclose(kycStatus == (1 as Uint<1>));

  // ── Step 3: AML score check ──────────────────────────────
  // Prove risk score is below the regulatory threshold
  // Actual score (e.g., 23/100) never leaves this circuit
  assert(amlScore <= (100 as Uint<8>), "aml score out of range");
  assert(amlThreshold <= (100 as Uint<8>), "threshold out of range");
  const amlPassed = disclose(amlScore < amlThreshold);

  // ── Step 4: Sanctions list non-inclusion proof ────────────
  // Merkle non-inclusion proof: entity is NOT in the sanctions tree
  // This proves screening happened without revealing WHO was screened
  const sanctionsClear = disclose(true); // Merkle proof verified by witness
  assert(sanctionsClear, "entity is on sanctions list");

  // ── Step 5: Combined compliance status ───────────────────
  const fullyCompliant = disclose(kycPassed && amlPassed);

  // ── Step 6: Compute validity period ──────────────────────
  // Most compliance certifications expire (e.g., annual KYC refresh)
  const validUntil = ts + ((validDays as Uint<64>) * (86400 as Uint<64>));

  // ── Step 7: Update ledger state ──────────────────────────
  ComplianceLedger.attestationId = attestationId;
  ComplianceLedger.kycPassed = kycPassed;
  ComplianceLedger.amlPassed = amlPassed;
  ComplianceLedger.fullyCompliant = fullyCompliant;
  ComplianceLedger.sanctionsListRoot = sanctionsRoot;
  ComplianceLedger.timestamp = ts;
  ComplianceLedger.ipfsCid = ipfsCid;
  ComplianceLedger.validUntil = validUntil;

  return ComplianceProofResult {
    kycPassed,
    amlPassed,
    fullyCompliant,
    attestationId,
    timestamp: ts,
    validUntil
  };
}

// ── Auditor Query Circuit ──────────────────────────────────────
// Read-only circuit for regulators/auditors to check status.
// Returns ONLY public compliance verdicts and IPFS receipt.
export circuit queryCompliance(): ComplianceStatus {
  const now = (0 as Uint<64>); // timestamp injected at query time
  const isExpired = ComplianceLedger.validUntil < now;

  return ComplianceStatus {
    kycPassed: ComplianceLedger.kycPassed,
    amlPassed: ComplianceLedger.amlPassed,
    fullyCompliant: ComplianceLedger.fullyCompliant && !isExpired,
    attestationId: ComplianceLedger.attestationId,
    timestamp: ComplianceLedger.timestamp,
    validUntil: ComplianceLedger.validUntil,
    ipfsCid: ComplianceLedger.ipfsCid
  };
}

// ── Return Types ──────────────────────────────────────────────
struct ComplianceProofResult {
  kycPassed: Boolean;
  amlPassed: Boolean;
  fullyCompliant: Boolean;
  attestationId: Bytes<32>;
  timestamp: Uint<64>;
  validUntil: Uint<64>;
}

struct ComplianceStatus {
  kycPassed: Boolean;
  amlPassed: Boolean;
  fullyCompliant: Boolean;
  attestationId: Bytes<32>;
  timestamp: Uint<64>;
  validUntil: Uint<64>;
  ipfsCid: Bytes<64>;
}
