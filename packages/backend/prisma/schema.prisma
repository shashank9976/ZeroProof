generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProofRecord {
  id            String   @id @default(uuid())
  entityAddress String
  cid           String   @unique
  type          String
  timestamp     DateTime @default(now())

  @@index([entityAddress, timestamp])
  @@index([type, timestamp])
}
