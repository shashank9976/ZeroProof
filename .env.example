# ==============================================================================
# ZeroProof Environment Variables
# Copy this file to .env and configure before running production deployment
# ==============================================================================

# ── 1. Backend API Configuration ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Set to 'false' in production to require real WASM proofs and IPFS uploads
ZK_MOCK_PROOFS=true

# ── 2. IPFS Storage (Pinata / Helia) ──────────────────────────────────────────
# Required if ZK_MOCK_PROOFS=false
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ── 3. Midnight Network Integration ───────────────────────────────────────────
# Deployed Compact Smart Contract Addresses (Run scripts/testnet-deploy.sh first)
NEXT_PUBLIC_CONTRACT_SOLVENCY=0x000...
NEXT_PUBLIC_CONTRACT_COMPLIANCE=0x000...

MIDNIGHT_NETWORK=testnet
MIDNIGHT_RPC_URL=https://rpc.testnet.midnight.network
MIDNIGHT_PROOF_SERVER_URL=https://proof-server.testnet.midnight.network

# Wallet seed used to deploy/interact with contracts
MIDNIGHT_WALLET_SEED=your_wallet_seed_hex_here

# ── 4. Next.js Frontend Configuration ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
